# Copy this file to Backend/.env and fill in the values. Never commit Backend/.env.

# Local development. Use false (or remove) in production.
DJANGO_DEBUG=true

# Required when DJANGO_DEBUG is false.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Required. Encrypts journal entries and session notes. Back it up.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# Optional. Managed PostgreSQL URL; SQLite is used when empty.
DATABASE_URL=

# Optional. Enables Gemini-generated analytics summaries.
GEMINI_API_KEY=
