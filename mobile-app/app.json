{
  "expo": {
    "name": "Rahati",
    "slug": "rahati",
    "scheme": "rahati",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FBF8FF",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rahati.app"
    },
    "android": {
      "package": "com.rahati.app",
      "adaptiveIcon": {
        "backgroundColor": "#FEABFE"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Rahati",
      "themeColor": "#FBF8FF",
      "backgroundColor": "#FBF8FF"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
